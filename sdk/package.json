{
  "name": "upstream-splits",
  "version": "0.1.0",
  "description": "TypeScript client for Upstream, weighted pull-based fund splits on Stellar",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Salmatcre8/upstream.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/Salmatcre8/upstream/tree/main/sdk#readme",
  "bugs": "https://github.com/Salmatcre8/upstream/issues",
  "keywords": [
    "stellar",
    "soroban",
    "splits",
    "payments",
    "funding"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "example:read": "npm run build && node dist/examples/read-split.js",
    "regenerate": "node scripts/check-bindings.mjs --write",
    "check-bindings": "node scripts/check-bindings.mjs"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.0.1",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.6.2"
  }
}
